import { EventEmitter } from 'events';
import AppDispatcher from '../dispatcher/AppDispatcher';

let items = [];

class ItemStore extends EventEmitter {
  getAll() {
    return items;
  }

  addItem(item) {
    items.push(item);
    this.emit('change');
  }

  handleActions(action) {
    switch (action.actionType) {
      case 'ADD_ITEM':
        this.addItem(action.item);
        break;
      default:
      // no-op
    }
  }
}

