        app: backend
    spec:
      containers:
        - name: backend
          image: myregistry/backend:latest
          ports:
            - containerPort: 5000
          env:
            - name: DATABASE_URL
              value: postgresql://postgres:password@db:5432/mydatabase
Example: Frontend Deployment (k8s/frontend-deployment.yml)
