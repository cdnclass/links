# Define a function to filter top-performing students
def filter_top_performers(data, subject, threshold):
    top_students = []
    for student in data['students']:
        if student['scores'][subject] >= threshold:
            top_students.append({
                "id": student['id'],
                "name": student['name'],
                "score": student['scores'][subject]
            })
    return top_students

# Filter example: Top performers in Math with a score of 90 or more
top_math_students = filter_top_performers(data, 'math', 90)
print("Top Performers in Math:", top_math_students)
What This Does:
Loops through each student in the dataset.

Checks if their score in the specified subject meets the threshold.

If so, adds their id, name, and score to the top_students list.

Returns a filtered list of top-performing students.

