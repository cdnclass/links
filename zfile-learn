import matplotlib.pyplot as plt

# Define a function to visualize the data
def visualize_data(filtered_data):
    # Extract names and scores
    names = [student["name"] for student in filtered_data]
    scores = [student["score"] for student in filtered_data]
    
    # Create the bar chart
    plt.figure(figsize=(10, 6))
    plt.bar(names, scores, color='skyblue')
    
    # Add labels and title
    plt.xlabel('Student Names')
    plt.ylabel('Scores')
    plt.title('Top Performers by Scores')
    plt.xticks(rotation=45)
    
    # Show the chart
    plt.tight_layout()
    plt.show()

# Call the function with the filtered data
visualize_data(top_math_students)
